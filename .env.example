PORT=3000

# Local dev
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sporttech?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/sporttech?schema=public

# Supabase on Vercel — use transaction pooler (port 6543), not direct 5432:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Optional: force TLS with relaxed cert check if hostname detection is not enough
# DATABASE_SSL=true

JWT_ACCESS_SECRET=replace_with_strong_secret
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace_with_another_strong_secret
JWT_REFRESH_EXPIRES_IN=7d

ADMIN_EMAIL=admin@sporttech.com
ADMIN_PASSWORD=Admin@123

ORGANIZER_EMAIL=organiser@sporttech.com
ORGANIZER_PASSWORD=Organiser@123

# 2Factor.in SMS OTP (https://2factor.in) — keep secret, never ship in the mobile app
TWO_FACTOR_API_KEY=XXXX-XXXX-XXXX-XXXX-XXXX
# Optional SMS OTP template name from: OTP Services → Manage OTP Templates
# Leave empty for default SMS. Never use a Voice OTP template name here.
TWO_FACTOR_OTP_TEMPLATE=

# Frontend URL used in organizer invite emails
FRONTEND_URL=http://localhost:5173

# SMTP for organizer invites (optional — if unset, invite links are logged to console)
# Microsoft Outlook / Microsoft 365: smtp.office365.com (personal Outlook.com: smtp-mail.outlook.com)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SportTech <noreply@sporttech.local>
