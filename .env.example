PORT=3000

# Local dev
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sporttech?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/sporttech?schema=public


JWT_ACCESS_SECRET=replace_with_strong_secret
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace_with_another_strong_secret
JWT_REFRESH_EXPIRES_IN=7d

ADMIN_EMAIL=admin@sporttech.com
ADMIN_PASSWORD=Admin@123

ORGANIZER_EMAIL=organiser@sporttech.com
ORGANIZER_PASSWORD=Organiser@123

# 2Factor.in SMS OTP (https://2factor.in) — keep secret, never ship in the mobile app
TWO_FACTOR_API_KEY=XXXX-XXXX-XXXX-XXXX-XXXX
# Optional SMS OTP template name from: OTP Services → Manage OTP Templates
# Leave empty for default SMS. Never use a Voice OTP template name here.
TWO_FACTOR_OTP_TEMPLATE=

# Frontend URL used in organizer invite emails
FRONTEND_URL=http://localhost:5173

# Google Places API (New) — server-side proxy for mobile location search
# Enable Places API (New) in Google Cloud; restrict key to Places APIs
GOOGLE_PLACES_API_KEY=

# Microsoft Graph API for organizer invites (optional — if unset, invite links are logged)
# Azure app registration needs application permission: Mail.Send (admin consent required)
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_FROM=SportTech <noreply@sporttech.local>
