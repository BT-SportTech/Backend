generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum SchoolType {
  PUBLIC
  PRIVATE
  INTERNATIONAL
  RESIDENTIAL
  GOVERNMENT_AIDED
}

enum UserRole {
  STUDENT
  PROFESSIONAL
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum AgeCategory {
  U12
  U14
  U16
  U18
  OPEN
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
}

// ─── School ──────────────────────────────────────────────────────────────────

model School {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  // 1. Basic
  name                 String
  code                 String      @unique
  logoUrl              String?
  type                 SchoolType
  yearEstablished      Int?
  managingOrganization String?
  principalName        String?
  chairmanName         String?
  tagline              String?
  website              String?
  contactNumber        String?
  email                String?

  // 2. Location
  state         String?
  district      String?
  city          String?
  landmark      String?
  fullAddress   String?
  pincode       String?
  googleMapsUrl String?
  latitude      Float?
  longitude     Float?

  // 6. Infrastructure
  campusArea         String?
  playground         String?
  sportsFacilities   String[]
  hasSwimmingPool    Boolean  @default(false)
  hasIndoorSportsArena Boolean @default(false)

  // 7. Faculty (non-duplicate)
  sportsInstructor String?

  // 8. Student counts
  totalStudents  Int?
  boysCount      Int?
  girlsCount     Int?
  boysEnrolled   Int?
  girlsEnrolled  Int?

  // 16. Media (URLs only)
  campusPhotos      String[]
  eventPhotos       String[]
  sportsEventPhotos String[]
  videos            String[]
  virtualTourUrl    String?

  // 17. Awards & Recognition
  bestSchoolAwards      String[]
  governmentRecognitions String[]
  accreditationDetails  String[]
  rankings              String[]
  certifications        String[]

  // Relations
  students     User[]
  eventSchools EventSchool[]
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  firstName   String
  lastName    String
  email       String   @unique
  phone       String?
  passwordHash String

  role        UserRole @default(STUDENT)
  gender      Gender?
  dateOfBirth DateTime?

  // Location
  state    String?
  district String?
  city     String?
  pincode  String?

  sportsInterested String[]

  // Student-only
  schoolId     String?
  presentClass Int?
  school       School? @relation(fields: [schoolId], references: [id])

  // Professional-only
  company String?

  // Relations
  refreshTokens      RefreshToken[]
  createdEvents      Event[]              @relation("EventCreator")
  eventRegistrations EventRegistration[]
}

// ─── Refresh Token ────────────────────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

// ─── Event ────────────────────────────────────────────────────────────────────

model Event {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  sport       String
  description String?
  venue       String

  startsAt DateTime
  endsAt   DateTime?

  registrationOpensAt  DateTime
  registrationClosesAt DateTime
  maxParticipants      Int

  status EventStatus @default(DRAFT)

  // Zone
  state    String
  district String

  ageCategory AgeCategory
  genders     Gender[]

  fee           Float @default(0)
  pointsReward  Int   @default(50)

  createdById String
  createdBy   User   @relation("EventCreator", fields: [createdById], references: [id])

  schools        EventSchool[]
  registrations  EventRegistration[]
}

model EventSchool {
  id       String @id @default(cuid())
  eventId  String
  schoolId String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([eventId, schoolId])
}

model EventRegistration {
  id           String             @id @default(cuid())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  eventId      String
  userId       String
  status       RegistrationStatus @default(CONFIRMED)
  registeredAt DateTime           @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}
