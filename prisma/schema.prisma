generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum SchoolType {
  PUBLIC
  PRIVATE
  INTERNATIONAL
  RESIDENTIAL
  GOVERNMENT_AIDED
}

enum UserRole {
  PLAYER
  PROFESSIONAL
  ADMIN
  ORGANIZER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum AgeCategory {
  U12
  U14
  U16
  U18
  OPEN
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
}

enum MatchOutcome {
  WIN
  LOSS
  DRAW
}

enum MatchmakingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ChessRoundStatus {
  PENDING
  ACTIVE
  COMPLETED
}

enum ChessBatchStatus {
  ACTIVE
  COMPLETED
}

enum ChessMatchResult {
  WHITE_WIN
  BLACK_WIN
  DRAW
}

enum ChessMatchStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// ─── School ──────────────────────────────────────────────────────────────────

model School {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  // 1. Basic
  name                 String
  code                 String      @unique
  logoUrl              String?
  type                 SchoolType
  yearEstablished      Int?
  managingOrganization String?
  principalName        String?
  chairmanName         String?
  tagline              String?
  website              String?
  contactNumber        String?
  email                String?

  // 2. Location
  state         String?
  district      String?
  city          String?
  landmark      String?
  fullAddress   String?
  pincode       String?
  googleMapsUrl String?
  latitude      Float?
  longitude     Float?

  // 6. Infrastructure
  campusArea         String?
  playground         String?
  sportsFacilities   String[]
  hasSwimmingPool    Boolean  @default(false)
  hasIndoorSportsArena Boolean @default(false)

  // 7. Faculty
  sportsInstructors Json?

  // 8. Student counts
  totalStudents  Int?
  boysCount      Int?
  girlsCount     Int?
  boysEnrolled   Int?
  girlsEnrolled  Int?

  // 16. Media (URLs only)
  campusPhotos      String[]
  eventPhotos       String[]
  sportsEventPhotos String[]
  videos            String[]
  virtualTourUrl    String?

  // 17. Awards & Recognition
  bestSchoolAwards      String[]
  governmentRecognitions String[]
  accreditationDetails  String[]
  rankings              String[]
  certifications        String[]

  // Relations
  players      User[]
  eventSchools EventSchool[]
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  firstName   String
  lastName    String
  username    String   @unique
  email       String?  @unique
  phone       String?
  passwordHash String

  role        UserRole @default(PLAYER)
  gender      Gender?
  dateOfBirth DateTime?

  // Location
  state     String?
  district  String?
  city      String?
  pincode   String?
  latitude  Float?
  longitude Float?

  sportsInterested String[]

  // Player-only
  schoolId     String?
  presentClass Int?
  school       School? @relation(fields: [schoolId], references: [id])

  // Professional-only
  company String?

  // Relations
  refreshTokens        RefreshToken[]
  createdEvents        Event[]              @relation("EventCreator")
  eventRegistrations   EventRegistration[]
  organizedEvents      EventOrganizer[]
  organizerInvites     OrganizerInvite[]    @relation("InviteCreator")
  attendanceMarked     EventRegistration[]  @relation("AttendanceMarker")
  withdrawnRegistrations EventRegistration[] @relation("WithdrawnMarker")
  completedChessMatches ChessMatch[]        @relation("ChessMatchCompleter")
  playerGameRatings    PlayerGameRating[]
}

// ─── Refresh Token ────────────────────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

// ─── Game ─────────────────────────────────────────────────────────────────────

model Game {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  name           String   @unique
  imageUrl       String?
  sidesPerMatch  Int      @default(2)
  playersPerSide Int
  winPoints      Int      @default(0)
  lossPoints     Int      @default(0)
  isActive       Boolean  @default(true)

  events           Event[]
  playerGameRatings PlayerGameRating[]
}

// ─── Event ────────────────────────────────────────────────────────────────────

model Event {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  sport       String
  description String?
  venue       String
  imageUrl    String?

  startsAt DateTime
  endsAt   DateTime?

  registrationOpensAt  DateTime
  registrationClosesAt DateTime
  maxParticipants      Int

  status EventStatus @default(DRAFT)

  // Zone (optional — empty = nationwide)
  state    String?
  district String?

  ageCategory AgeCategory
  genders     Gender[]

  fee           Float @default(0)
  pointsReward  Int   @default(50)
  lossPoints    Int   @default(0)

  boardCount           Int?
  gamesPerPlayer       Int               @default(3)
  matchmakingStatus    MatchmakingStatus @default(NOT_STARTED)
  matchmakingStartedAt DateTime?

  gameId String?
  game   Game?  @relation(fields: [gameId], references: [id])

  createdById String
  createdBy   User   @relation("EventCreator", fields: [createdById], references: [id])

  schools        EventSchool[]
  registrations  EventRegistration[]
  organizers     EventOrganizer[]
  chessRounds    ChessRound[]
}

model EventOrganizer {
  id       String @id @default(cuid())
  eventId  String
  userId   String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model OrganizerInvite {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  email       String
  firstName   String
  lastName    String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  invitedBy   User      @relation("InviteCreator", fields: [invitedById], references: [id])

  @@index([email])
}

model EventSchool {
  id       String @id @default(cuid())
  eventId  String
  schoolId String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([eventId, schoolId])
}

model EventRegistration {
  id           String             @id @default(cuid())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  eventId      String
  userId       String
  status       RegistrationStatus @default(CONFIRMED)
  registeredAt DateTime           @default(now())
  outcome      MatchOutcome?
  pointsEarned Int                @default(0)

  amountPaid     Float    @default(0)
  paymentRef     String?  @unique
  paidAt         DateTime?
  paymentMethod  String?

  attendedAt   DateTime?
  attendedById String?
  attendedBy   User?              @relation("AttendanceMarker", fields: [attendedById], references: [id])

  withdrawnAt   DateTime?
  withdrawnById String?
  withdrawnBy   User? @relation("WithdrawnMarker", fields: [withdrawnById], references: [id])

  eventWins      Int @default(0)
  eventLosses    Int @default(0)
  eventDraws     Int @default(0)
  gamesCompleted Int @default(0)
  whiteGames     Int @default(0)
  blackGames     Int @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  whiteChessMatches ChessMatch[] @relation("WhitePlayer")
  blackChessMatches ChessMatch[] @relation("BlackPlayer")

  @@unique([eventId, userId])
}

// ─── Chess Matchmaking ────────────────────────────────────────────────────────

model PlayerGameRating {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  gameId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game   Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  rating      Int @default(10000)
  gamesPlayed Int @default(0)
  wins        Int @default(0)
  losses      Int @default(0)
  draws       Int @default(0)

  @@unique([userId, gameId])
  @@index([gameId, rating])
}

model ChessRound {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventId     String
  roundNumber Int
  status      ChessRoundStatus @default(PENDING)

  event   Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  batches ChessRoundBatch[]

  @@unique([eventId, roundNumber])
}

model ChessRoundBatch {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roundId     String
  batchNumber Int
  status      ChessBatchStatus @default(ACTIVE)
  boardCount  Int

  round   ChessRound   @relation(fields: [roundId], references: [id], onDelete: Cascade)
  matches ChessMatch[]

  @@unique([roundId, batchNumber])
}

model ChessMatch {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batchId      String
  boardNumber  Int
  whiteRegistrationId String
  blackRegistrationId String
  result       ChessMatchResult?
  status       ChessMatchStatus @default(SCHEDULED)
  completedAt  DateTime?
  completedById String?
  whiteRatingBefore Int?
  whiteRatingAfter  Int?
  blackRatingBefore Int?
  blackRatingAfter  Int?

  batch             ChessRoundBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  whiteRegistration EventRegistration @relation("WhitePlayer", fields: [whiteRegistrationId], references: [id], onDelete: Cascade)
  blackRegistration EventRegistration @relation("BlackPlayer", fields: [blackRegistrationId], references: [id], onDelete: Cascade)
  completedBy       User?             @relation("ChessMatchCompleter", fields: [completedById], references: [id])

  @@unique([batchId, boardNumber])
  @@index([whiteRegistrationId])
  @@index([blackRegistrationId])
}
